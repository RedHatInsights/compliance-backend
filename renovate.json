{
  "dependencyDashboard": true,
  "gitIgnoredAuthors": [
    "jvasik@redhat.com",
    "rblanco@redhat.com",
    "petrblaho@redhat.com"
  ],
  "extends": [
    "github>konflux-ci/mintmaker-presets:refresh-rpm-lockfiles"
  ],
  "ignorePaths": [
    ".pre-commit-config.yaml"
  ],
  "baseBranchPatterns": [
    "master"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.tekton/.*\\.yaml$/"
      ],
      "matchStrings": [
        "RedHatInsights/konflux-pipelines/raw/v(?<currentValue>[\\d.]+)"
      ],
      "depNameTemplate": "RedHatInsights/konflux-pipelines",
      "datasourceTemplate": "github-releases"
    }
  ],
  "rpmVulnerabilityAlerts": false,
  "packageRules": [
    {
      "description": "Group all GitHub Actions updates into one PR",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Group Rust crate version updates.",
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest",
        "rollback",
        "bump"
      ],
      "groupName": "Rust dependencies"
    },
    {
      "description": "Group cargo and rpm lock refreshes into one PR",
      "matchManagers": [
        "cargo",
        "rpm-lockfile"
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "groupName": "lock refresh",
      "group": {
        "commitMessageAction": "lock refresh",
        "commitMessageTopic": null,
        "commitMessageExtra": null
      }
    },
    {
      "description": "Pin postgres Docker image to v16",
      "matchPackageNames": [
        "postgres"
      ],
      "allowedVersions": "<=16"
    },
    {
      "matchPackageNames": [
        "RedHatInsights/konflux-pipelines"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Disable all bundler dependency updates",
      "matchManagers": [
        "bundler"
      ],
      "enabled": false
    },
    {
      "description": "Disable all ruby version updates",
      "matchManagers": [
        "ruby-version"
      ],
      "enabled": false
    }
  ],
  "tekton": {
    "enabled": true,
    "packageRules": [
      {
        "matchUpdateTypes": [
          "digest"
        ],
        "platformAutomerge": true,
        "automerge": true
      }
    ]
  }
}
